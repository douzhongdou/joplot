# ---- 绘图工作台（apps/plot）----
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.hardgit.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=

# ---- 两个独立域名之间的入口 ----
# 两个应用各部署在自己的域名上，导航里给对方留一个入口。值是站点根，不带路径；
# 未配置时对应入口自动隐藏，因此本地开发可以都不配。
# 绘图工作台里的「图像」入口：
NEXT_PUBLIC_IMAGE_APP_URL=
# 图像工作台里的「绘图」入口：
NEXT_PUBLIC_PLOT_APP_URL=

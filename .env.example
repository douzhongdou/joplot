# 分别复制到需要配置的 apps/<应用>/.env.local，或对应 Vercel Project。
# 应用不会自动读取仓库根的 .env.local。

# ---- 每个应用自己的 Umami 配置 ----
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.hardgit.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=

# ---- 新 joplot（apps/plot，仅预览）----
# 新应用自己的地址；不要填写老 joplot 的线上域名。
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_IMAGE_APP_URL=

# ---- joimage（apps/image）----
# 新 joplot 尚未上线时留空，对应入口自动隐藏。
NEXT_PUBLIC_PLOT_APP_URL=

# 老 joplot（apps/legacy-plot）保持原有 Umami 配置，无共享应用入口。

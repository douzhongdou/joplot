# ---- 绘图工作台（apps/plot）----
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.hardgit.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=

# ---- 同域部署（一个域名、按路径拆分）----
# 绘图工作台（主应用）把 /imagej 与 /imagej-assets 反代到图像应用部署源；不配则不反代。
IMAGE_APP_ORIGIN=
# 图像应用的静态资源同源前缀（路径，不是绝对 URL），需与 apps/plot/next.config.ts 的保持一致。
IMAGE_ASSET_PREFIX=/imagej-assets
